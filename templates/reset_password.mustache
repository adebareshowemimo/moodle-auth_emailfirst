{{!
    @template auth_emailfirst/reset_password

    Reset password template.

    @copyright  2026 Course Commerce Pro
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Context variables:
    * wwwroot - Site root URL
    * sitename - Site name
    * logourl - Logo URL
    * token - Reset token
    * sesskey - Session key for form
    * errors - Array of error messages
    * success - Whether password was reset successfully
    * validtoken - Whether the token is valid
    * loginurl - Login page URL
    * forgotpasswordurl - Forgot password page URL
}}

<div class="emailfirst-container" style="max-width: 500px; margin: 2rem auto;">
    <div class="text-center mb-4">
        {{#logourl}}
            <img src="{{{logourl}}}" alt="{{sitename}}" style="max-height: 60px; max-width: 200px;">
        {{/logourl}}
        {{^logourl}}
            <h2>{{sitename}}</h2>
        {{/logourl}}
    </div>

    <div class="card border-0">
        <div class="card-body">
            {{#success}}
                <div class="text-center mb-4">
                    <i class="fa fa-check-circle fa-4x text-success mb-3"></i>
                    <h3>{{#str}}passwordresetsuccess, auth_emailfirst{{/str}}</h3>
                </div>

                <p class="text-center">{{#str}}passwordresetsuccess_desc, auth_emailfirst{{/str}}</p>

                <div class="mt-4 text-center">
                    <a href="{{{postreseturl}}}" class="btn btn-primary btn-lg w-100">
                        {{#str}}continuetodashboard, auth_emailfirst{{/str}}
                    </a>
                </div>
            {{/success}}

            {{^success}}
                {{#validtoken}}
                    <div class="text-center mb-4">
                        <i class="fa fa-lock fa-3x text-primary mb-3"></i>
                        <h3>{{#str}}resetpassword, auth_emailfirst{{/str}}</h3>
                        <p class="text-muted">{{#str}}resetpassword_desc, auth_emailfirst{{/str}}</p>
                    </div>

                    {{#errors.general}}
                        <div class="alert alert-danger">
                            <i class="fa fa-exclamation-circle"></i> {{{errors.general}}}
                        </div>
                    {{/errors.general}}

                    <form method="post" action="{{{wwwroot}}}/auth/emailfirst/reset_password.php">
                        <input type="hidden" name="token" value="{{{token}}}">
                        <input type="hidden" name="sesskey" value="{{{sesskey}}}">
                        <input type="hidden" name="confirm" value="1">

                        <div class="mb-3">
                            <label for="password" class="form-label">{{#str}}newpassword, auth_emailfirst{{/str}}</label>
                            <input type="password"
                                   class="form-control form-control-lg {{#errors.password}}is-invalid{{/errors.password}}"
                                   id="password"
                                   name="password"
                                   required
                                   autofocus>
                            {{#errors.password}}
                                <div class="invalid-feedback">{{{errors.password}}}</div>
                            {{/errors.password}}
                        </div>

                        <div class="mb-3">
                            <label for="password2" class="form-label">{{#str}}confirmpassword, auth_emailfirst{{/str}}</label>
                            <input type="password"
                                   class="form-control form-control-lg {{#errors.password2}}is-invalid{{/errors.password2}}"
                                   id="password2"
                                   name="password2"
                                   required>
                            {{#errors.password2}}
                                <div class="invalid-feedback">{{{errors.password2}}}</div>
                            {{/errors.password2}}
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                            <i class="fa fa-check"></i> {{#str}}resetpasswordbutton, auth_emailfirst{{/str}}
                        </button>

                        <div class="text-center mt-3">
                            <a href="{{{loginurl}}}">
                                {{#str}}backtologin, auth_emailfirst{{/str}}
                            </a>
                        </div>
                    </form>
                {{/validtoken}}

                {{^validtoken}}
                    <div class="text-center mb-4">
                        <i class="fa fa-times-circle fa-4x text-danger mb-3"></i>
                        <h3>{{#str}}invalidresettoken, auth_emailfirst{{/str}}</h3>
                        <p class="text-muted">{{#str}}invalidresettoken_desc, auth_emailfirst{{/str}}</p>
                    </div>

                    <div class="mt-4 text-center">
                        <a href="{{{forgotpasswordurl}}}" class="btn btn-primary btn-lg w-100">
                            <i class="fa fa-redo"></i> {{#str}}requestnewlink, auth_emailfirst{{/str}}
                        </a>
                    </div>

                    <div class="text-center mt-3">
                        <a href="{{{loginurl}}}">
                            {{#str}}backtologin, auth_emailfirst{{/str}}
                        </a>
                    </div>
                {{/validtoken}}
            {{/success}}
        </div>
    </div>
</div>
