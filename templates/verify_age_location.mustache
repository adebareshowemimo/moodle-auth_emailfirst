{{!
    @template auth_emailfirst/verify_age_location

    Branded age and location verification page for the Email-First Authentication plugin.

    @copyright  2026 Course Commerce Pro
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Context variables required for this template:
    * logourl - Logo url (string|false),
    * logostyle - Inline CSS for logo dimensions,
    * sitename - Name of the site,
    * heading - Page heading text,
    * subheading - Explanation text,
    * actionurl - Form action URL,
    * sesskey - Session key for CSRF protection,
    * age - Pre-filled age value,
    * countries - Array of {value, label, selected},
    * error - Error message (string|false),
    * errors - Object of field => error message,
    * loginurl - Login page URL,
    * showcontact - Show contact info,
    * contacttext - Contact text,

    Example context (json):
    {
        "logourl": false,
        "logostyle": "max-height:80px;",
        "sitename": "My Site",
        "heading": "Verify your age",
        "subheading": "Before creating an account, we need to verify your age and location.",
        "actionurl": "/auth/emailfirst/verify_age_location.php",
        "sesskey": "abc123",
        "age": "",
        "countries": [
            {
                "value": "US",
                "label": "United States",
                "selected": true
            }
        ],
        "error": false,
        "errors": {},
        "loginurl": "/login/index.php",
        "showcontact": false,
        "contacttext": ""
    }
}}

<div class="signupform auth-emailfirst-signupform">
    <div class="text-center mb-4">
        {{#logourl}}
            <div class="signup-logo">
                <img src="{{logourl}}" class="img-fluid" alt="{{sitename}}" style="{{logostyle}}"/>
            </div>
        {{/logourl}}
        {{#heading}}
            <h2 class="mt-3">{{heading}}</h2>
        {{/heading}}
        {{#subheading}}
            <p class="text-muted">{{subheading}}</p>
        {{/subheading}}
    </div>

    {{#error}}
        <div class="alert alert-danger" role="alert">
            {{{error}}}
        </div>
    {{/error}}

    <form method="post" action="{{actionurl}}" id="verify-age-form" novalidate>
        <input type="hidden" name="sesskey" value="{{sesskey}}">

        <fieldset>
            <div class="mb-3">
                <label for="age" class="form-label">{{#str}} whatisyourage {{/str}}</label>
                <input type="number" class="form-control {{#errors.age}}is-invalid{{/errors.age}}"
                       id="age" name="age" value="{{age}}" min="1" max="120" required>
                {{#errors.age}}
                    <div class="invalid-feedback">{{errors.age}}</div>
                {{/errors.age}}
            </div>

            <div class="mb-3">
                <label for="country" class="form-label">{{#str}} wheredoyoulive {{/str}}</label>
                <select class="form-control {{#errors.country}}is-invalid{{/errors.country}}"
                        id="country" name="country" required>
                    {{#countries}}
                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/countries}}
                </select>
                {{#errors.country}}
                    <div class="invalid-feedback">{{errors.country}}</div>
                {{/errors.country}}
            </div>

            <div class="mb-3">
                <button class="btn btn-primary btn-lg w-100" type="submit">
                    {{#str}} proceed {{/str}}
                </button>
            </div>

            <div class="text-center mt-3">
                <span class="text-muted">{{#str}} alreadyhaveaccount, auth_emailfirst {{/str}}</span>
                <a href="{{loginurl}}">{{#str}} login {{/str}}</a>
            </div>
        </fieldset>
    </form>

    {{#showcontact}}
        <div class="auth-emailfirst-contact text-center mt-3 pt-3 border-top">
            <small class="text-muted">{{contacttext}}</small>
        </div>
    {{/showcontact}}
</div>
