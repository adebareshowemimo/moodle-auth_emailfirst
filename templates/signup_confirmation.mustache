{{!
    @template auth_emailfirst/signup_confirmation

    Confirmation page shown after signup (verification sent or account created).

    @copyright  2026 Course Commerce Pro
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Context variables:
    * logourl - Logo url (string|false),
    * logostyle - Inline CSS for logo dimensions,
    * sitename - Name of the site,
    * heading - Page heading text,
    * message - Main message text,
    * submessage - Secondary message (e.g. "check your inbox"),
    * email - User email (if verification sent),
    * actionurl - Button URL,
    * actionlabel - Button label,
    * showcontact - Show contact info,
    * contacttext - Contact text,
    * icon - Icon class (e.g. fa-envelope, fa-check-circle),
    * variant - success or info

    Example context (json):
    {
        "logourl": false,
        "logostyle": "max-height:80px;",
        "sitename": "My Site",
        "heading": "Verification email sent!",
        "message": "We've sent a verification link to",
        "email": "user@example.com",
        "submessage": "Please check your inbox.",
        "actionurl": "/",
        "actionlabel": "Continue",
        "showcontact": false,
        "contacttext": "",
        "icon": "fa-envelope",
        "variant": "info"
    }
}}

<div class="auth-emailfirst-signupform auth-emailfirst-confirmation">
    <div class="text-center mb-4">
        {{#logourl}}
            <div class="signup-logo mb-3">
                <img src="{{logourl}}" class="img-fluid" alt="{{sitename}}" style="{{logostyle}}"/>
            </div>
        {{/logourl}}

        <div class="confirmation-icon my-4">
            <i class="fa {{icon}} fa-3x text-{{variant}}"></i>
        </div>

        <h2 class="mt-3 mb-2">{{heading}}</h2>

        <p class="text-muted mt-2">
            {{message}}
            {{#email}}
                <br><strong>{{email}}</strong>
            {{/email}}
        </p>

        {{#submessage}}
            <p class="text-muted small">{{submessage}}</p>
        {{/submessage}}

        <div class="mt-4">
            <a href="{{actionurl}}" class="btn btn-primary btn-lg px-5">{{actionlabel}}</a>
        </div>
    </div>

    {{#showcontact}}
        <div class="auth-emailfirst-contact text-center text-muted mt-5 mb-2">
            <small>{{contacttext}}</small>
        </div>
    {{/showcontact}}
</div>
