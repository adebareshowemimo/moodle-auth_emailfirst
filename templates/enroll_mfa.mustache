{{!
    @template auth_emailfirst/enroll_mfa

    MFA Enrollment Page Template

    @copyright  2026 Course Commerce Pro
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Context variables:
    * sitename - Site name
    * heading - Page heading
    * content - Main content text
    * in_grace_period - Whether user is in grace period
    * grace_until - Formatted date/time when grace period ends
    * factors - Array of available MFA factors {id, name, description, setup_url}
    * skip_url - URL to skip MFA enrollment

    Example context (json):
    {
        "sitename": "My Site",
        "heading": "Set up multi-factor authentication",
        "content": "Choose an authentication method to continue.",
        "in_grace_period": true,
        "grace_until": "1 January 2027",
        "factors": [
            {
                "name": "Authenticator app",
                "description": "Use a time-based code from your authenticator app.",
                "setup_url": "/admin/tool/mfa/user_preferences.php"
            }
        ],
        "skip_url": "/my/"
    }
}}

<div class="mfa-enrollment-page">
    <div class="container">
        <div class="mfa-enrollment-container">
            <div class="mfa-header">
                <h1>{{heading}}</h1>
                <p class="mfa-intro">{{content}}</p>
            </div>

            {{#factors}}
                <div class="mfa-factors-section">
                    <h2 class="mfa-section-heading">{{#str}}mfa_enrollment_available_factors, auth_emailfirst{{/str}}</h2>
                    <p class="mfa-section-intro">{{#str}}mfa_enrollment_select_method, auth_emailfirst{{/str}}</p>

                    <div class="mfa-factors-grid">
                        {{#.}}
                            <div class="mfa-factor-card">
                                <div class="mfa-factor-header">
                                    <h3 class="mfa-factor-name">{{name}}</h3>
                                </div>
                                <div class="mfa-factor-body">
                                    <p class="mfa-factor-description">{{description}}</p>
                                </div>
                                <div class="mfa-factor-footer">
                                    <a href="{{setup_url}}" class="btn btn-primary mfa-setup-btn">
                                        {{#str}}mfa_enrollment_setup, auth_emailfirst{{/str}}
                                    </a>
                                </div>
                            </div>
                        {{/.}}
                    </div>
                </div>
            {{/factors}}

            {{^factors}}
                <div class="alert alert-info">
                    <p>{{#str}}mfa_enrollment_no_factors, auth_emailfirst{{/str}}</p>
                </div>
            {{/factors}}

            {{#in_grace_period}}
                <div class="mfa-grace-period-section">
                    <div class="alert alert-warning">
                        <h4>{{#str}}mfa_enrollment_grace_period, auth_emailfirst{{/str}}</h4>
                        <p>{{#str}}mfa_enrollment_grace_text, auth_emailfirst, {{grace_until}}{{/str}}</p>
                    </div>

                    <form method="post" class="mfa-skip-form">
                        {{#sesskey}}{{/sesskey}}
                        <input type="hidden" name="action" value="skip">
                        <a href="{{skip_url}}" class="btn btn-secondary mfa-skip-btn">
                            {{#str}}mfa_enrollment_skip, auth_emailfirst{{/str}}
                        </a>
                    </form>
                </div>
            {{/in_grace_period}}
        </div>
    </div>
</div>
