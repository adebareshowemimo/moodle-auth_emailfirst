{{!
    @template auth_emailfirst/forgot_password

    Forgot password template.

    @copyright  2026 Course Commerce Pro
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Context variables:
    * wwwroot - Site root URL
    * sitename - Site name
    * logourl - Logo URL (string|false)
    * logostyle - Inline CSS for logo dimensions
    * heading - Page heading
    * subheading - Page subheading
    * email - User's email address
    * sesskey - Session key for form
    * error - Error message (if any)
    * emailsent - Whether email was sent successfully
    * loginurl - Login page URL
    * signupurl - Signup page URL
    * showcontact - Show contact info
    * contacttext - Contact text

    Example context (json):
    {
        "wwwroot": "https://example.com",
        "sitename": "My Site",
        "logourl": false,
        "logostyle": "max-height:80px;",
        "heading": "Forgot Password",
        "subheading": "Enter your email to reset your password.",
        "email": "",
        "sesskey": "abc123",
        "error": "",
        "emailsent": false,
        "loginurl": "/login/index.php",
        "signupurl": "/auth/emailfirst/signup.php",
        "showcontact": false,
        "contacttext": ""
    }
}}

<div class="auth-emailfirst-signupform auth-emailfirst-forgot-password">
    <div class="text-center mb-4">
        {{#logourl}}
            <div class="signup-logo mb-3">
                <img src="{{logourl}}" class="img-fluid" alt="{{sitename}}" style="{{logostyle}}"/>
            </div>
        {{/logourl}}
    </div>

    {{#emailsent}}
        <div class="text-center mb-4">
            <div class="confirmation-icon my-3">
                <i class="fa fa-envelope fa-3x text-success"></i>
            </div>
            <h2 class="mt-3">{{#str}}passwordresetemailsent, auth_emailfirst{{/str}}</h2>
        </div>

        <div class="alert alert-success">
            <p class="mb-1">{{#str}}passwordresetemailsent_desc, auth_emailfirst{{/str}}</p>
            {{#email}}
                <p class="mb-0"><strong>{{email}}</strong></p>
            {{/email}}
        </div>

        <p class="text-muted small text-center">{{#str}}passwordresetemailsent_check, auth_emailfirst{{/str}}</p>

        <div class="mt-4">
            <a href="{{loginurl}}" class="btn btn-primary btn-lg w-100">
                {{#str}}gotologin, auth_emailfirst{{/str}}
            </a>
        </div>
    {{/emailsent}}

    {{^emailsent}}
        <div class="text-center mb-4">
            <div class="confirmation-icon my-3">
                <i class="fa fa-key fa-3x text-primary"></i>
            </div>
            <h2 class="mt-3">{{heading}}</h2>
            {{#subheading}}
                <p class="text-muted mt-2">{{subheading}}</p>
            {{/subheading}}
        </div>

        {{#error}}
            <div class="alert alert-danger">
                <i class="fa fa-exclamation-circle"></i> {{{error}}}
            </div>
        {{/error}}

        <form method="post" action="{{wwwroot}}/auth/emailfirst/forgot_password.php">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="confirm" value="1">

            <div class="mb-3">
                <label for="email" class="form-label">{{#str}}email{{/str}} <abbr class="text-danger" title="{{#str}}required{{/str}}">*</abbr></label>
                <input type="email"
                       class="form-control form-control-lg"
                       id="email"
                       name="email"
                       value="{{email}}"
                       placeholder="{{#str}}forgotpassword_email_help, auth_emailfirst{{/str}}"
                       required
                       autofocus>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                {{#str}}sendresetlink, auth_emailfirst{{/str}}
            </button>

            <div class="text-center mt-3">
                <a href="{{loginurl}}">{{#str}}backtologin, auth_emailfirst{{/str}}</a>
                <span class="mx-2 text-muted">|</span>
                <a href="{{signupurl}}">{{#str}}signup_heading, auth_emailfirst{{/str}}</a>
            </div>
        </form>
    {{/emailsent}}

    {{#showcontact}}
        <div class="auth-emailfirst-contact text-center text-muted mt-5 mb-2">
            <small>{{contacttext}}</small>
        </div>
    {{/showcontact}}
</div>
